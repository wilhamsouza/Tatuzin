}

model AnalyticsCustomerDailySnapshot {
  id                   String   @id @default(uuid())
  companyId            String
  snapshotDate         DateTime
  customerKey          String
  customerId           String?
  customerNameSnapshot String
  salesCount           Int      @default(0)
  revenueCents         Int      @default(0)
  costCents            Int      @default(0)
  profitCents          Int      @default(0)
  fiadoPaymentsCents   Int      @default(0)
  materializedAt       DateTime @default(now())
  updatedAt            DateTime @updatedAt
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, snapshotDate, customerKey])
  @@index([companyId, snapshotDate])
  @@index([companyId, customerId])
}
