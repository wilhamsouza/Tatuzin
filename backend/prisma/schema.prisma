generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
}

enum LicenseStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum SessionClientType {
  MOBILE_APP
  ADMIN_WEB
  UNKNOWN
}

enum CompanyDeviceStatus {
  PENDING
  ACTIVE
  BLOCKED
  REVOKED
}

enum SyncEventStatus {
  PENDING
  ACCEPTED
  DUPLICATE
  REJECTED
  CONFLICT
  FAILED
}

enum SyncConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum SyncSupportCommandStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum SyncSupportCommandType {
  RETRY_FAILED_SYNC_EVENTS
  REPAIR_OPERATIONAL_ORDER_ITEM_TOTAL_CENTS
  CLEAR_RESOLVED_CONFLICT_CACHE
  FORCE_SYNC_PULL
  REFRESH_SYNC_STATUS
}

enum CustomerTaskStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum CustomerTimelineEventType {
  NOTE_ADDED
  TASK_CREATED
  TAGS_UPDATED
}

enum HybridPricePolicyMode {
  ADVISORY
  GOVERNED
}

enum HybridCustomerMasterMode {
  CLOUD_MASTER
  HYBRID_REVIEW
}

enum HybridPromotionMode {
  MANUAL_PREVIEW
  SCHEDULED_REVIEW
}

enum EmployeeCommissionType {
  NONE
  PERCENTAGE
  FIXED_PER_SALE
}

enum EmployeeCommissionBase {
  GROSS_SALES
  NET_SALES
  GROSS_PROFIT
}

enum AdminAuditActorType {
  USER
  SYSTEM
  BOOTSTRAP
  SERVICE
}

enum SupportActionExecutionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id                         String                   @id @default(uuid())
  email                      String                   @unique
  passwordHash               String
  name                       String
  isActive                   Boolean                  @default(true)
  isPlatformAdmin            Boolean                  @default(false)
  mustChangePassword         Boolean                  @default(false)
  temporaryPasswordExpiresAt DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  memberships                Membership[]
  billingCheckoutSessions    BillingCheckoutSession[]
  billingAdminAuditLogs      BillingAdminAuditLog[]
  adminAuditLogs             AdminAuditLog[]          @relation("AdminAuditActor")
  adminUserPermissions       AdminUserPermission[]     @relation("AdminUserPermissionActor")
  deviceSessions             DeviceSession[]
  companyDevices             CompanyDevice[]
  syncEvents                 SyncEvent[]
  syncConflicts              SyncConflict[]           @relation("SyncConflictUser")
  resolvedSyncConflicts      SyncConflict[]           @relation("SyncConflictResolver")
  syncIncidents              SyncIncident[]
  syncSupportCommands        SyncSupportCommand[]     @relation("SyncSupportCommandActor")
  deviceSyncDiagnostics      DeviceSyncDiagnostic[]
  cashSessions               CashSession[]
  operationalOrders          OperationalOrder[]
  passwordResetTokens        PasswordResetToken[]
  sessionAuditActorLogs      SessionAuditLog[]        @relation("SessionAuditActor")
  sessionAuditSubjectLogs    SessionAuditLog[]        @relation("SessionAuditSubject")
  customerNotesAuthored      CustomerNote[]           @relation("CustomerNoteAuthor")
  customerTasksCreated       CustomerTask[]           @relation("CustomerTaskCreator")
  customerTasksAssigned      CustomerTask[]           @relation("CustomerTaskAssignee")
  customerTagAssignments     CustomerTagAssignment[]  @relation("CustomerTagAssignmentActor")
  customerTimelineEvents     CustomerTimelineEvent[]  @relation("CustomerTimelineActor")
  employeeProfiles           EmployeeProfile[]        @relation("EmployeeProfileUser")
  employeeProfilesCreated    EmployeeProfile[]        @relation("EmployeeProfileCreatedBy")
  employeeProfilesUpdated    EmployeeProfile[]        @relation("EmployeeProfileUpdatedBy")
}

model AdminUserPermission {
  id            String   @id @default(uuid())
  actorUserId   String
  permissionKey String
  scope         String   @default("platform")
  scopeId       String   @default("*")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  actorUser     User     @relation("AdminUserPermissionActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, permissionKey, scope, scopeId])
  @@index([actorUserId, isActive])
  @@index([permissionKey])
  @@index([scope, scopeId])
}

model Company {
  id                              String                           @id @default(uuid())
  name                            String
  legalName                       String
  documentNumber                  String?
  receiptDisplayName              String?
  receiptDocument                 String?
  receiptPhone                    String?
  receiptAddress                  String?
  receiptFooterMessage            String?
  showDocumentOnReceipt           Boolean                          @default(true)
  showPhoneOnReceipt              Boolean                          @default(true)
  showAddressOnReceipt            Boolean                          @default(true)
  showFooterMessageOnReceipt      Boolean                          @default(true)
  slug                            String                           @unique
  isActive                        Boolean                          @default(true)
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  memberships                     Membership[]
  license                         License?
  billingCheckoutSessions         BillingCheckoutSession[]
  billingProviderEvents           BillingProviderEvent[]
  billingInvoices                 BillingInvoice[]
  billingAdminAuditLogs           BillingAdminAuditLog[]
  syncState                       CompanySyncState?
  adminAuditLogs                  AdminAuditLog[]                  @relation("AdminAuditCompany")
  deviceSessions                  DeviceSession[]
  companyDevices                  CompanyDevice[]
  syncEvents                      SyncEvent[]
  syncCheckpoints                 SyncCheckpoint[]
  syncConflicts                   SyncConflict[]
  syncIncidents                   SyncIncident[]
  syncSupportCommands             SyncSupportCommand[]
  deviceSyncDiagnostics           DeviceSyncDiagnostic[]
  sessionAuditLogs                SessionAuditLog[]                @relation("SessionAuditCompany")
  suppliers                       Supplier[]
  supplies                        Supply[]
  productRecipeItems              ProductRecipeItem[]
  categories                      Category[]
  products                        Product[]
  customers                       Customer[]
  purchases                       Purchase[]
  sales                           Sale[]
  financialEvents                 FinancialEvent[]
  costs                           Cost[]
  fiadoPayments                   FiadoPayment[]
  cashEvents                      CashEvent[]
  cashSessions                    CashSession[]
  operationalOrders               OperationalOrder[]
  operationalOrderItems           OperationalOrderItem[]
  stockReservations               StockReservation[]
  stockDeductions                 StockDeduction[]
  supplyCostHistory               SupplyCostHistory[]
  analyticsCompanyDailySnapshots  AnalyticsCompanyDailySnapshot[]
  analyticsProductDailySnapshots  AnalyticsProductDailySnapshot[]
  analyticsCustomerDailySnapshots AnalyticsCustomerDailySnapshot[]
  crmCustomerTags                 CustomerTag[]
  crmCustomerTagAssignments       CustomerTagAssignment[]
  crmCustomerNotes                CustomerNote[]
  crmCustomerTasks                CustomerTask[]
  crmCustomerTimelineEvents       CustomerTimelineEvent[]
  hybridGovernanceProfile         HybridGovernanceProfile?
  employeeProfiles                EmployeeProfile[]
}

model Membership {
  id               String            @id @default(uuid())
  userId           String
  companyId        String
  role             MembershipRole    @default(OPERATOR)
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceSessions   DeviceSession[]
  employeeProfiles EmployeeProfile[]

  @@unique([userId, companyId])
  @@index([companyId])
}

model EmployeeProfile {
  id                   String                 @id @default(uuid())
  companyId            String
  userId               String?
  membershipId         String?
  name                 String
  email                String?
  emailNormalized      String?
  phone                String?
  role                 String
  status               String                 @default("ACTIVE")
  permissions          Json?
  invitedAt            DateTime?
  inviteTokenHash      String?
  inviteExpiresAt      DateTime?
  acceptedAt           DateTime?
  disabledAt           DateTime?
  commissionEnabled    Boolean                @default(false)
  commissionType       EmployeeCommissionType @default(NONE)
  commissionBase       EmployeeCommissionBase @default(NET_SALES)
  commissionRateBps    Int?
  commissionFixedCents Int?
  commissionUpdatedAt  DateTime?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User?                  @relation("EmployeeProfileUser", fields: [userId], references: [id], onDelete: SetNull)
  membership           Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  createdByUser        User?                  @relation("EmployeeProfileCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser        User?                  @relation("EmployeeProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, membershipId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, role])
  @@index([companyId, commissionEnabled])
  @@index([companyId, userId])
  @@index([companyId, membershipId])
}

model License {
  id                        String        @id @default(uuid())
  companyId                 String        @unique
  plan                      String
  status                    LicenseStatus @default(TRIAL)
  startsAt                  DateTime
  expiresAt                 DateTime?
  maxDevices                Int?
  syncEnabled               Boolean       @default(true)
  billingProvider           String?
  providerSubscriptionId    String?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  nextPaymentDate           DateTime?
  cancelAtPeriodEnd         Boolean       @default(false)
  cancelRequestedAt         DateTime?
  canceledAt                DateTime?
  pendingPlan               String?
  pendingPlanRequestedAt    DateTime?
  billingSubscriptionStatus String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  company                   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([syncEnabled])
  @@index([expiresAt])
  @@index([billingProvider])
  @@index([providerSubscriptionId])
}

model BillingCheckoutSession {
  id                 String    @id @default(uuid())
  companyId          String
  userId             String
  plan               String
  billingCycle       String
  status             String    @default("PENDING")
  provider           String
  providerReference  String?
  checkoutUrl        String?
  sandboxCheckoutUrl String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([provider, providerReference])
}

model BillingProviderEvent {
  id              String    @id @default(uuid())
  companyId       String?
  provider        String
  eventType       String
  providerEventId String?
  dedupeKey       String
  payload         Json
  status          String
  processedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([provider, dedupeKey])
  @@index([companyId])
  @@index([providerEventId])
  @@index([status])
  @@index([createdAt])
}

model BillingInvoice {
  id                     String    @id @default(uuid())
  companyId              String
  provider               String
  providerInvoiceId      String?
  providerSubscriptionId String?
  plan                   String?
  status                 String
  amountCents            Int       @default(0)
  currency               String    @default("BRL")
  periodStart            DateTime?
  periodEnd              DateTime?
  dueAt                  DateTime?
  paidAt                 DateTime?
  failedAt               DateTime?
  invoiceUrl             String?
  payload                Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([status])
  @@index([dueAt])
  @@index([providerSubscriptionId])
}

model BillingAdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  companyId   String?
  action      String
  reason      String
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actorUser   User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model CompanyDevice {
  id                  String                @id @default(uuid())
  companyId           String
  userId              String
  clientInstanceId    String
  deviceLabel         String?
  platform            String?
  appVersion          String?
  status              CompanyDeviceStatus   @default(PENDING)
  approvedAt          DateTime?
  approvedByUserId    String?
  lastSeenAt          DateTime?
  revokedAt           DateTime?
  revokedReason       String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncEvents          SyncEvent[]
  syncCheckpoints     SyncCheckpoint[]
  syncConflicts       SyncConflict[]
  syncIncidents       SyncIncident[]
  syncSupportCommands SyncSupportCommand[]
  syncDiagnostic      DeviceSyncDiagnostic?
  cashSessions        CashSession[]
  operationalOrders   OperationalOrder[]

  @@unique([companyId, clientInstanceId])
  @@unique([companyId, id])
  @@index([companyId])
  @@index([userId])
  @@index([status])
}

model CompanySyncState {
  companyId                  String   @id
  currentVersion             BigInt   @default(0)
  serverFirstSnapshotVersion BigInt   @default(0)
  updatedAt                  DateTime @updatedAt
  company                    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SyncEvent {
  id               String          @id @default(uuid())
  companyId        String
  deviceId         String
  userId           String
  eventId          String
  feature          String
  entity           String
  operation        String
  entityLocalId    String?
  entityServerId   String?
  occurredAt       DateTime
  payload          Json
  status           SyncEventStatus @default(PENDING)
  serverVersion    BigInt?
  rejectionCode    String?
  rejectionMessage String?
  materializedAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device           CompanyDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conflict         SyncConflict?
  incidents        SyncIncident[]

  @@unique([companyId, deviceId, eventId])
  @@index([companyId, serverVersion])
  @@index([companyId, feature, serverVersion])
  @@index([companyId, entity])
  @@index([status])
}

model SyncCheckpoint {
  id                String        @id @default(uuid())
  companyId         String
  deviceId          String
  feature           String
  lastServerVersion BigInt        @default(0)
  lastPushedAt      DateTime?
  lastPulledAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device            CompanyDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([companyId, deviceId, feature])
  @@index([companyId, deviceId])
  @@index([companyId, feature])
}

model SyncConflict {
  id               String             @id @default(uuid())
  companyId        String
  deviceId         String
  userId           String
  syncEventId      String             @unique
  entity           String
  entityLocalId    String?
  entityServerId   String?
  code             String
  message          String
  status           SyncConflictStatus @default(OPEN)
  payload          Json?
  resolution       Json?
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device           CompanyDevice      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user             User               @relation("SyncConflictUser", fields: [userId], references: [id], onDelete: Cascade)
  syncEvent        SyncEvent          @relation(fields: [syncEventId], references: [id], onDelete: Cascade)
  resolvedBy       User?              @relation("SyncConflictResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, entity])
  @@index([deviceId])
}

model SyncIncident {
  id          String         @id @default(uuid())
  companyId   String?
  deviceId    String?
  userId      String?
  syncEventId String?
  code        String
  message     String
  severity    String         @default("warn")
  details     Json?
  createdAt   DateTime       @default(now())
  company     Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device      CompanyDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  syncEvent   SyncEvent?     @relation(fields: [syncEventId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([deviceId, createdAt])
  @@index([code])
}

model SyncSupportCommand {
  id               String                   @id @default(uuid())
  companyId        String
  deviceId         String
  actorUserId      String
  command          SyncSupportCommandType
  status           SyncSupportCommandStatus @default(PENDING)
  reason           String
  confirmationText String?
  dryRunResult     Json?
  payload          Json?
  result           Json?
  errorMessage     String?
  requestedAt      DateTime                 @default(now())
  pickedUpAt       DateTime?
  completedAt      DateTime?
  expiresAt        DateTime
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device           CompanyDevice            @relation(fields: [companyId, deviceId], references: [companyId, id], onDelete: Cascade)
  actorUser        User                     @relation("SyncSupportCommandActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, deviceId, status])
  @@index([companyId, status])
  @@index([deviceId, status])
  @@index([expiresAt])
  @@index([requestedAt])
}

model DeviceSyncDiagnostic {
  id                    String        @id @default(uuid())
  companyId             String
  deviceId              String
  userId                String?
  clientInstanceId      String?
  clientType            String?
  appVersion            String?
  platform              String?
  localSchemaVersion    String?
  pendingCount          Int           @default(0)
  failedCount           Int           @default(0)
  openConflictCount     Int           @default(0)
  resolvedConflictCount Int           @default(0)
  ignoredConflictCount  Int           @default(0)
  lastLocalError        String?
  lastLocalErrorCode    String?
  lastLocalErrorEntity  String?
  lastPushAt            DateTime?
  lastPullAt            DateTime?
  lastSuccessfulSyncAt  DateTime?
  safeDetails           Json?
  reportedAt            DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device                CompanyDevice @relation(fields: [companyId, deviceId], references: [companyId, id], onDelete: Cascade)
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([companyId, deviceId])
  @@index([companyId, reportedAt])
  @@index([deviceId])
}

model AdminAuditLog {
  id              String   @id @default(uuid())
  actorType        AdminAuditActorType @default(USER)
  actorUserId     String?
  actorLabel      String?
  targetCompanyId String?
  action          String
  details         Json?
  createdAt       DateTime @default(now())
  actorUser       User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetCompany   Company? @relation("AdminAuditCompany", fields: [targetCompanyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([actorType])
  @@index([actorUserId])
  @@index([targetCompanyId])
}

model SupportActionExecution {
  id                    String                       @id @default(uuid())
  idempotencyKey        String                       @unique
  requestFingerprint    String
  dryRunAuditEventId    String
  actionType            String
  targetCompanyId       String
  targetType            String
  targetId              String
  actorUserId           String
  reason                String
  status                SupportActionExecutionStatus @default(PENDING)
  beforeAuditEventId    String?
  afterAuditEventId     String?
  result                Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  executedAt            DateTime?

  @@index([dryRunAuditEventId])
  @@index([actionType, targetCompanyId, targetType, targetId])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
}

model DeviceSession {
  id                    String            @id @default(uuid())
  userId                String
  companyId             String
  membershipId          String
  clientType            SessionClientType @default(MOBILE_APP)
  clientInstanceId      String
  deviceLabel           String?
  platform              String?
  appVersion            String?
  refreshTokenHash      String            @unique
  refreshTokenExpiresAt DateTime
  lastSeenAt            DateTime          @default(now())
  lastRefreshedAt       DateTime?
  revokedAt             DateTime?
  revokedReason         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  membership            Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  auditLogs             SessionAuditLog[]

  @@index([companyId, clientType, revokedAt])
  @@index([companyId, clientType, clientInstanceId])
  @@index([userId, companyId, revokedAt])
  @@index([refreshTokenExpiresAt])
  @@index([lastSeenAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model SessionAuditLog {
  id              String         @id @default(uuid())
  deviceSessionId String?
  actorUserId     String?
  subjectUserId   String?
  companyId       String?
  action          String
  details         Json?
  createdAt       DateTime       @default(now())
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)
  actorUser       User?          @relation("SessionAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subjectUser     User?          @relation("SessionAuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  company         Company?       @relation("SessionAuditCompany", fields: [companyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([companyId])
  @@index([deviceSessionId])
  @@index([actorUserId])
  @@index([subjectUserId])
}

model RateLimitBucket {
  bucketHash   String   @id
  scope        String
  requestCount Int
  resetAt      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scope, resetAt])
}

model Category {
  id          String    @id @default(uuid())
  companyId   String
  localUuid   String
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, localUuid])
  @@index([companyId, updatedAt])
  @@index([companyId, name])
}

model Product {
  id                                     String                  @id @default(uuid())
  companyId                              String
  localUuid                              String
  categoryId                             String?
  name                                   String
  description                            String?
  barcode                                String?
  productType                            String                  @default("unidade")
  niche                                  String                  @default("alimentacao")
  catalogType                            String                  @default("simple")
  modelName                              String?
  variantLabel                           String?
  unitMeasure                            String                  @default("un")
  costPriceCents                         Int                     @default(0)
  manualCostCents                        Int                     @default(0)
  costSource                             String                  @default("manual")
  variableCostSnapshotCents              Int?
  estimatedGrossMarginCents              Int?
  estimatedGrossMarginPercentBasisPoints Int?
  lastCostUpdatedAt                      DateTime?
  salePriceCents                         Int
  stockMil                               Int                     @default(0)
  isActive                               Boolean                 @default(true)
  deletedAt                              DateTime?
  createdAt                              DateTime                @default(now())
  updatedAt                              DateTime                @updatedAt
  company                                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category                               Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants                               ProductVariant[]
  modifierGroups                         ProductModifierGroup[]
  linkedModifierOptions                  ProductModifierOption[] @relation("ProductModifierLinkedProduct")
  saleItems                              SaleItem[]
  purchaseItems                          PurchaseItem[]
  operationalOrderItems                  OperationalOrderItem[]
  recipeItems                            ProductRecipeItem[]
  stockReservations                      StockReservation[]
  stockDeductions                        StockDeduction[]

